  echo -e "${C}║${W} Battery Optimization Settings       ${C}║${N}"
  echo -e "${C}║${W} Mobile Data & Data Saver            ${C}║${N}"
  echo -e "${C}║${W} Phone Storage & Space Cleaner       ${C}║${N}"
  echo -e "${C}║${G} Local APK Scanner (Search by Name)  ${C}║${N}"
