#!/data/data/com.termux/files/usr/bin/bash

# Cyber / Hacker Terminal Colors
G='\033[1;32m'
C='\033[1;36m'
Y='\033[1;33m'
R='\033[1;31m'
W='\033[1;37m'
D='\033[0;90m'
N='\033[0m'

VIDEO_DIR=~/storage/movies
MUSIC_DIR=~/storage/music
PIC_DIR=~/storage/pictures
DOC_DIR=~/storage/shared/Documents
APK_DIR=~/storage/shared/Documents/APKs
ARCHIVE_FILE=~/.yt-dlp-archive.txt
AUDIO_ARCHIVE=~/.yt-dlp-audio-archive.txt
BATCH_FILE=~/links.txt

mkdir -p "$VIDEO_DIR" "$MUSIC_DIR" "$PIC_DIR" "$DOC_DIR" "$APK_DIR"
touch "$BATCH_FILE"

command -v termux-wake-lock &> /dev/null && termux-wake-lock

OUT_TMPL="%(playlist_title&{}/|)s%(playlist_index&{} - |)s%(title)s.%(ext)s"
BASE_FLAGS="-4 -N 2 --sleep-interval 3 --max-sleep-interval 8 --download-archive $ARCHIVE_FILE"
BATCH_FLAGS="-4 -N 3 --sleep-interval 5 --max-sleep-interval 12 --download-archive $ARCHIVE_FILE"
SUB_FLAGS="--write-subs --write-auto-subs --sub-lang en --embed-subs"

run_ytdlp() {
  while true; do
    yt-dlp "$@"
    EXIT_CODE=$?
    if [ $EXIT_CODE -ne 0 ]; then
      echo ""
      echo -e "${R}╔══════════════════════════════════════════╗${N}"
      echo -e "${R}║${Y}  [!] DOWNLOAD INTERRUPTED (CODE $EXIT_CODE)       ${R}║${N}"
      echo -e "${R}╠══════════════════════════════════════════╣${N}"
      echo -e "${R}║${W} If YouTube blocked with 429 Rate Limit:  ${R}║${N}"
      echo -e "${R}║${W} 1. Turn Airplane Mode ON for 10 seconds  ${R}║${N}"
      echo -e "${R}║${W} 2. Turn Airplane Mode OFF for fresh IP   ${R}║${N}"
      echo -e "${R}║${G} 3. Press [Enter] to retry or [q] to quit ${R}║${N}"
      echo -e "${R}╚══════════════════════════════════════════╝${N}"
      command -v termux-notification &> /dev/null && termux-notification --title "Download Interrupted" --content "Toggle Airplane Mode 10s if 429 occurred, then press Enter in Termux!" --sound
      read -p "$(echo -e "${Y}Press [Enter] to retry (or type q to abort): ${N}")" retry_ans
      if [[ "$retry_ans" == "q" || "$retry_ans" == "Q" ]]; then
        echo -e "${D}Download aborted.${N}"
        break
      fi
      echo -e "${C}[RETRY] Resuming download...${N}"
    else
      break
    fi
  done
}

get_target_image() {
  local URL_IN="$1"
  TARGET_IMG=""
  echo -e "${C}╔══════════════════════════════════════════╗${N}"
  echo -e "${C}║${G}          SELECT IMAGE SOURCE             ${C}║${N}"
  echo -e "${C}╠══════════════════════════════════════════╣${N}"
  echo -e "${C}║${W} Download from Current URL           ${C}║${N}"
  echo -e "${C}║${W} Pick Local Image from Phone Storage ${C}║${N}"
  echo -e "${C}║${R} Cancel                              ${C}║${N}"
  echo -e "${C}╚══════════════════════════════════════════╝${N}"
  read -p "$(echo -e "${Y}Choose source [01-02]: ${N}")" img_src

  if [[ "$img_src" == "01" || "$img_src" == "1" ]]; then
    if [ -z "$URL_IN" ]; then
      read -p "$(echo -e "${Y}Paste image/post URL: ${N}")" URL_IN
    fi
    [ -z "$URL_IN" ] && return
    TMP_IMG_DIR=$(mktemp -d)
    CLEAN_IMG="${URL_IN%%\?*}"
    if [[ "${CLEAN_IMG,,}" =~ \.(jpg|jpeg|png|webp|gif|bmp)$ ]]; then
      curl -s -L -A "Mozilla/5.0" -J -O --output-dir "$TMP_IMG_DIR" "$URL_IN"
    elif command -v gallery-dl &> /dev/null; then
      gallery-dl -d "$TMP_IMG_DIR" --directory "" "$URL_IN"
    else
      curl -s -L -A "Mozilla/5.0" -J -O --output-dir "$TMP_IMG_DIR" "$URL_IN"
    fi
    DL_IMG=$(find "$TMP_IMG_DIR" -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" \) | head -n 1)
    if [ -n "$DL_IMG" ]; then
      BASE_N=$(basename "$DL_IMG")
      mv "$DL_IMG" "$PIC_DIR/$BASE_N"
      TARGET_IMG="$PIC_DIR/$BASE_N"
      echo -e "${G}[OK] Original saved: Pictures/$BASE_N${N}"
    else
      echo -e "${R}[ERR] Failed to download image from URL.${N}"
    fi
    rm -rf "$TMP_IMG_DIR"
  elif [[ "$img_src" == "02" || "$img_src" == "2" ]]; then
    read -p "$(echo -e "${Y}Search image name (or [Enter] for latest 15): ${N}")" iq
    if [ -n "$iq" ]; then
      mapfile -t IMG_LIST < <(find -L ~/storage/shared -path "*/Android/data" -prune -o -path "*/Android/obb" -prune -o -type f \( -iname "*${iq}*.jpg" -o -iname "*${iq}*.jpeg" -o -iname "*${iq}*.png" -o -iname "*${iq}*.webp" \) -print 2>/dev/null | head -n 15)
    else
      mapfile -t IMG_LIST < <(find -L ~/storage/shared -path "*/Android/data" -prune -o -path "*/Android/obb" -prune -o -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" \) -print 2>/dev/null | head -n 15)
    fi
    if [ ${#IMG_LIST[@]} -eq 0 ]; then
      echo -e "${R}[ERR] No matching images found.${N}"
      return
    fi
    for i in "${!IMG_LIST[@]}"; do
      printf "${C}║${W} [%02d] %s${N}\n" $((i+1)) "${IMG_LIST[$i]#$HOME/storage/shared/}"
    done
    read -p "$(echo -e "${Y}Select image number: ${N}")" inum
    if [[ "$inum" =~ ^[0-9]+$ ]] && [ "$inum" -ge 1 ] && [ "$inum" -le ${#IMG_LIST[@]} ]; then
      TARGET_IMG="${IMG_LIST[$((inum-1))]}"
    fi
  fi
}

image_submenu() {
  echo -e "${C}╔══════════════════════════════════════════╗${N}"
  echo -e "${C}║${G}     IMAGE, EXPO & WEB ASSET MATRIX       ${C}║${N}"
  echo -e "${C}╠══════════════════════════════════════════╣${N}"
  echo -e "${C}║${W} Original Full Resolution (URL)      ${C}║${N}"
  echo -e "${C}║${W} 1:1 Square Crop (1080x1080)         ${C}║${N}"
  echo -e "${C}║${W} 16:9 Widescreen (1920x1080)         ${C}║${N}"
  echo -e "${C}║${W} 9:16 Vertical (1080x1920)           ${C}║${N}"
  echo -e "${C}║${W} 4:5 Portrait (1080x1350)            ${C}║${N}"
  echo -e "${C}║${W} Blurred-BG Fit (No Edge Cropping)   ${C}║${N}"
  echo -e "${C}║${W} Convert Format & Compress Size      ${C}║${N}"
  echo -e "${C}║${W} Strip EXIF / GPS Metadata (Privacy) ${C}║${N}"
  echo -e "${C}║${W} Custom Ratio or Pixel Dimensions    ${C}║${N}"
  echo -e "${C}║${G} Expo App Asset Pack (icon/splash)   ${C}║${N}"
  echo -e "${C}║${G} Web / PWA Favicon & OG Banner Pack  ${C}║${N}"
  echo -e "${C}║${C} Combine Multiple Images into PDF    ${C}║${N}"
  echo -e "${C}║${R} Cancel                              ${C}║${N}"
  echo -e "${C}╚══════════════════════════════════════════╝${N}"
  read -p "$(echo -e "${Y}Select image operation [01-12]: ${N}")" im_choice

  if [[ "$im_choice" == "00" || "$im_choice" == "0" || "$im_choice" == "13" ]]; then
    echo -e "${D}Cancelled.${N}"
    return
  fi

  if [[ "$im_choice" == "01" || "$im_choice" == "1" ]]; then
    local U="$1"
    [ -z "$U" ] && read -p "$(echo -e "${Y}Paste image/post URL: ${N}")" U
    [ -z "$U" ] && return
    CLEAN_I="${U%%\?*}"
    if [[ "${CLEAN_I,,}" =~ \.(jpg|jpeg|png|webp|gif|bmp)$ ]]; then
      curl -L -A "Mozilla/5.0" -J -O --output-dir "$PIC_DIR" "$U"
    elif command -v gallery-dl &> /dev/null; then
      gallery-dl -d "$PIC_DIR" --directory "" "$U"
    else
      curl -L -A "Mozilla/5.0" -J -O --output-dir "$PIC_DIR" "$U"
    fi
    SCAN_TARGET="$PIC_DIR"
    MSG="Original image(s) saved to Pictures!"
    return
  fi

  if [[ "$im_choice" == "12" ]]; then
    read -p "$(echo -e "${Y}Enter folder path or press [Enter] for Pictures: ${N}")" pdf_src
    [ -z "$pdf_src" ] && pdf_src="$PIC_DIR"
    read -p "$(echo -e "${Y}Output PDF name (e.g., my_album): ${N}")" pdf_out
    [ -z "$pdf_out" ] && pdf_out="combined_images"
    python3 -c '
import sys, glob, os
try:
    from PIL import Image
except ImportError:
    print("ERR_PIL")
    sys.exit(1)
src, out = sys.argv, sys.argv
files = sorted(glob.glob(os.path.join(src, "*.jpg")) + glob.glob(os.path.join(src, "*.jpeg")) + glob.glob(os.path.join(src, "*.png")))
if not files:
    print("NO_FILES")
    sys.exit(1)
imgs = [Image.open(f).convert("RGB") for f in files[:30]]
imgs.save(out, save_all=True, append_images=imgs)
print(f"OK|{len(imgs)}")
' "$pdf_src" "$DOC_DIR/${pdf_out%.pdf}.pdf"
    SCAN_TARGET="$DOC_DIR"
    MSG="Combined images into PDF in Documents!"
    return
  fi

  get_target_image "$1"
  [ -z "$TARGET_IMG" ] && return
  STEM="${TARGET_IMG%.*}"
  EXT="${TARGET_IMG##*.}"

  case $im_choice in
    02|2)
      ffmpeg -y -v error -i "$TARGET_IMG" -vf "crop='min(iw,ih)':'min(iw,ih)',scale=1080:1080" "${STEM}_1x1.jpg"
      echo -e "${G}[OK] Saved: $(basename "${STEM}_1x1.jpg")${N}"
      ;;
    03|3)
      ffmpeg -y -v error -i "$TARGET_IMG" -vf "crop='min(iw,ih*16/9)':'min(ih,iw*9/16)',scale=1920:1080" "${STEM}_16x9.jpg"
      echo -e "${G}[OK] Saved: $(basename "${STEM}_16x9.jpg")${N}"
      ;;
    04|4)
      ffmpeg -y -v error -i "$TARGET_IMG" -vf "crop='min(iw,ih*9/16)':'min(ih,iw*16/9)',scale=1080:1920" "${STEM}_9x16.jpg"
      echo -e "${G}[OK] Saved: $(basename "${STEM}_9x16.jpg")${N}"
      ;;
    05|5)
      ffmpeg -y -v error -i "$TARGET_IMG" -vf "crop='min(iw,ih*4/5)':'min(ih,iw*5/4)',scale=1080:1350" "${STEM}_4x5.jpg"
      echo -e "${G}[OK] Saved: $(basename "${STEM}_4x5.jpg")${N}"
      ;;
    06|6)
      read -p "$(echo -e "${Y}Target frame (1 = 1:1 Square, 2 = 16:9 Wide, 3 = 9:16 Vertical): ${N}")" bf
      W_OUT=1080; H_OUT=1080
      [[ "$bf" == "2" ]] && W_OUT=1920 && H_OUT=1080
      [[ "$bf" == "3" ]] && W_OUT=1080 && H_OUT=1920
      ffmpeg -y -v error -i "$TARGET_IMG" -filter_complex "[0:v]scale=${W_OUT}:${H_OUT}:force_original_aspect_ratio=increase,crop=${W_OUT}:${H_OUT},boxblur=25:5[bg];[0:v]scale=${W_OUT}:${H_OUT}:force_original_aspect_ratio=decrease[fg];[bg][fg]overlay=(W-w)/2:(H-h)/2" "${STEM}_blurfit.jpg"
      echo -e "${G}[OK] Saved: $(basename "${STEM}_blurfit.jpg")${N}"
      ;;
    07|7)
      read -p "$(echo -e "${Y}Target format (jpg / png / webp): ${N}")" fmt
      [ -z "$fmt" ] && fmt="jpg"
      ffmpeg -y -v error -i "$TARGET_IMG" -vf "scale='min(1440,iw)':-2" -q:v 4 "${STEM}_opt.${fmt,,}"
      echo -e "${G}[OK] Saved compressed: $(basename "${STEM}_opt.${fmt,,}")${N}"
      ;;
    08|8)
      ffmpeg -y -v error -i "$TARGET_IMG" -map_metadata -1 -c:v copy "${STEM}_clean.${EXT}" 2>/dev/null || ffmpeg -y -v error -i "$TARGET_IMG" -map_metadata -1 "${STEM}_clean.jpg"
      echo -e "${G}[OK] EXIF/GPS metadata stripped!${N}"
      ;;
    09|9)
      read -p "$(echo -e "${Y}Enter Width x Height (e.g., 800x600): ${N}")" dim
      W_C="${dim%x*}"; H_C="${dim#*x}"
      ffmpeg -y -v error -i "$TARGET_IMG" -vf "scale=${W_C}:${H_C}:force_original_aspect_ratio=increase,crop=${W_C}:${H_C}" "${STEM}_${W_C}x${H_C}.jpg"
      echo -e "${G}[OK] Saved custom size: ${W_C}x${H_C}${N}"
      ;;
    10)
      read -p "$(echo -e "${Y}Splash background color hex (e.g., #FFFFFF or #000000): ${N}")" bg_hex
      [ -z "$bg_hex" ] && bg_hex="#FFFFFF"
      EXPO_OUT="$PIC_DIR/Expo_Assets"
      mkdir -p "$EXPO_OUT"
      ffmpeg -y -v error -i "$TARGET_IMG" -vf "crop='min(iw,ih)':'min(iw,ih)',scale=1024:1024" "$EXPO_OUT/icon.png"
      ffmpeg -y -v error -i "$TARGET_IMG" -vf "crop='min(iw,ih)':'min(iw,ih)',scale=660:660,pad=1024:1024:(ow-iw)/2:(oh-ih)/2:color=0x00000000" "$EXPO_OUT/adaptive-icon.png"
      ffmpeg -y -v error -f lavfi -i "color=c=${bg_hex}:s=1284x2778" -i "$TARGET_IMG" -filter_complex "[1:v]crop='min(iw,ih)':'min(iw,ih)',scale=520:520[logo];[0:v][logo]overlay=(W-w)/2:(H-h)/2" -frames:v 1 "$EXPO_OUT/splash-icon.png"
      ffmpeg -y -v error -i "$EXPO_OUT/icon.png" -vf "scale=48:48" "$EXPO_OUT/favicon.png"
      ffmpeg -y -v error -i "$EXPO_OUT/icon.png" -vf "scale=96:96" "$EXPO_OUT/notification-icon.png"
      echo -e "${G}[OK] Expo asset pack generated in Pictures/Expo_Assets/!${N}"
      ;;
    11)
      WEB_OUT="$PIC_DIR/Web_Assets"
      mkdir -p "$WEB_OUT"
      ffmpeg -y -v error -i "$TARGET_IMG" -vf "crop='min(iw,ih*1200/630)':'min(ih,iw*630/1200)',scale=1200:630" "$WEB_OUT/og-banner-1200x630.png"
      ffmpeg -y -v error -i "$TARGET_IMG" -vf "crop='min(iw,ih)':'min(iw,ih)',scale=512:512" "$WEB_OUT/icon-512.png"
      ffmpeg -y -v error -i "$TARGET_IMG" -vf "crop='min(iw,ih)':'min(iw,ih)',scale=192:192" "$WEB_OUT/icon-192.png"
      ffmpeg -y -v error -i "$TARGET_IMG" -vf "crop='min(iw,ih)':'min(iw,ih)',scale=180:180" "$WEB_OUT/apple-touch-icon.png"
      echo -e "${G}[OK] Web/PWA asset pack generated in Pictures/Web_Assets/!${N}"
      ;;
  esac
  SCAN_TARGET="$PIC_DIR"
  MSG="Image processing complete!"
}

online_app_installer() {
  if ! command -v apkeep &> /dev/null; then
    echo -e "${Y}[INFO] Installing apkeep CLI tool first...${N}"
    pkg install apkeep -y
  fi

  echo -e "${C}╔══════════════════════════════════════════╗${N}"
  echo -e "${C}║${G}   ONLINE REPOSITORY INSTALLER (apkeep)   ${C}║${N}"
  echo -e "${C}╠══════════════════════════════════════════╣${N}"
  echo -e "${C}║${W} APKPure Source (Mainstream Apps)    ${C}║${N}"
  echo -e "${C}║${W} F-Droid Source (Open-Source Apps)   ${C}║${N}"
  echo -e "${C}║${R} Cancel                              ${C}║${N}"
  echo -e "${C}╚══════════════════════════════════════════╝${N}"
  read -p "$(echo -e "${Y}Select source [01-02]: ${N}")" src_choice

  if [[ "$src_choice" == "00" || "$src_choice" == "0" || -z "$src_choice" ]]; then
    echo -e "${D}Cancelled.${N}"
    return
  fi

  read -p "$(echo -e "${Y}Target app name or package ID (e.g., vlc, sai, whatsapp): ${N}")" query
  if [ -z "$query" ]; then
    echo -e "${D}Cancelled.${N}"
    return
  fi

  case "${query,,}" in
    x|twitter) PKG_ID="com.twitter.android" ;;
    whatsapp) PKG_ID="com.whatsapp" ;;
    telegram) PKG_ID="org.telegram.messenger" ;;
    tiktok) PKG_ID="com.zhiliaoapp.musically" ;;
    instagram) PKG_ID="com.instagram.android" ;;
    facebook) PKG_ID="com.facebook.katana" ;;
    chrome) PKG_ID="com.android.chrome" ;;
    vlc) PKG_ID="org.videolan.vlc" ;;
    spotify) PKG_ID="com.spotify.music" ;;
    sai) PKG_ID="com.aefyr.sai.fdroid" ;;
    *) PKG_ID="$query" ;;
  esac

  if [[ "$PKG_ID" != *.* ]]; then
    echo -e "${C}[SCAN] Resolving package ID for '$query'...${N}"
    HTML_PAGE=$(curl -s -L -A "Mozilla/5.0" --max-time 15 --get --data-urlencode "q=$query" "https://apkpure.com")
    FOUND_PKG=$(printf "%s" "$HTML_PAGE" | grep -oE '/[a-zA-Z0-9_-]+/[a-zA-Z0-9_]+\.[a-zA-Z0-9_.]+' | head -n 1 | cut -d'/' -f3)
    if [ -n "$FOUND_PKG" ]; then
      PKG_ID="$FOUND_PKG"
      echo -e "${G}[MATCH] Package ID: $PKG_ID${N}"
    else
      echo -e "${R}[ERR] Could not resolve package ID. Enter exact ID (e.g., org.videolan.vlc).${N}"
      return
    fi
  fi

  if [[ "$src_choice" == "02" || "$src_choice" == "2" ]]; then
    SOURCE_FLAG="f-droid"
  else
    SOURCE_FLAG="apk-pure"
  fi

  echo -e "${C}[DOWN] Pulling $PKG_ID from $SOURCE_FLAG...${N}"
  apkeep -a "$PKG_ID" -d "$SOURCE_FLAG" "$APK_DIR"

  LATEST_APK=$(ls -t "$APK_DIR"/"$PKG_ID"* 2>/dev/null | head -n 1)
  if [ -n "$LATEST_APK" ]; then
    verify_and_install_apk "$LATEST_APK"
    SCAN_TARGET="$APK_DIR"
  else
    echo -e "${R}[ERR] Download failed or package blocked by remote server.${N}"
    MSG="Failed to download $PKG_ID."
  fi
}

