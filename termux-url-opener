#!/data/data/com.termux/files/usr/bin/bash

# Cyber / Hacker Terminal Colors
G='\033[1;32m'
C='\033[1;36m'
Y='\033[1;33m'
R='\033[1;31m'
W='\033[1;37m'
D='\033[0;90m'
N='\033[0m'

VIDEO_DIR=~/storage/movies
MUSIC_DIR=~/storage/music
PIC_DIR=~/storage/pictures
DOC_DIR=~/storage/shared/Documents
APK_DIR=~/storage/shared/Documents/APKs
ARCHIVE_FILE=~/.yt-dlp-archive.txt
AUDIO_ARCHIVE=~/.yt-dlp-audio-archive.txt
BATCH_FILE=~/links.txt

mkdir -p "$VIDEO_DIR" "$MUSIC_DIR" "$PIC_DIR" "$DOC_DIR" "$APK_DIR"
touch "$BATCH_FILE"

command -v termux-wake-lock &> /dev/null && termux-wake-lock

OUT_TMPL="%(playlist_title&{}/|)s%(playlist_index&{} - |)s%(title)s.%(ext)s"
BASE_FLAGS="-4 -N 2 --sleep-interval 3 --max-sleep-interval 8 --download-archive $ARCHIVE_FILE"
BATCH_FLAGS="-4 -N 3 --sleep-interval 5 --max-sleep-interval 12 --download-archive $ARCHIVE_FILE"
SUB_FLAGS="--write-subs --write-auto-subs --sub-lang en --embed-subs"

run_ytdlp() {
  while true; do
    yt-dlp "$@"
    EXIT_CODE=$?
    if [ $EXIT_CODE -ne 0 ]; then
      echo ""
      echo -e "${R}╔══════════════════════════════════════════╗${N}"
      echo -e "${R}║${Y}  [!] DOWNLOAD INTERRUPTED (CODE $EXIT_CODE)       ${R}║${N}"
      echo -e "${R}╠══════════════════════════════════════════╣${N}"
      echo -e "${R}║${W} If YouTube blocked with 429 Rate Limit:  ${R}║${N}"
      echo -e "${R}║${W} 1. Turn Airplane Mode ON for 10 seconds  ${R}║${N}"
      echo -e "${R}║${W} 2. Turn Airplane Mode OFF for fresh IP   ${R}║${N}"
      echo -e "${R}║${G} 3. Press [Enter] to retry or [q] to quit ${R}║${N}"
      echo -e "${R}╚══════════════════════════════════════════╝${N}"
      command -v termux-notification &> /dev/null && termux-notification --title "Download Interrupted" --content "Toggle Airplane Mode 10s if 429 occurred, then press Enter in Termux!" --sound
      read -p "$(echo -e "${Y}Press [Enter] to retry (or type q to abort): ${N}")" retry_ans
      if [[ "$retry_ans" == "q" || "$retry_ans" == "Q" ]]; then
        echo -e "${D}Download aborted.${N}"
        break
      fi
      echo -e "${C}[RETRY] Resuming download...${N}"
    else
      break
    fi
  done
}

verify_and_install_apk() {
  local FILE_PATH="$1"
  local INSTALL_TARGET="$FILE_PATH"
  local TEMP_EXTRACT=""

  if [ ! -s "$FILE_PATH" ]; then
    echo -e "${R}[ERR] File is missing or empty (0 bytes).${N}"
    MSG="APK error: File empty."
    return
  fi

  if ! unzip -tq "$FILE_PATH" &> /dev/null; then
    echo -e "${R}[ERR] File is corrupted or is an HTML webpage instead of a valid package.${N}"
    MSG="APK error: Invalid package."
    return
  fi

  if [[ "${FILE_PATH,,}" == *.xapk ]]; then
    echo -e "${Y}[INFO] Split-APK bundle (.xapk) detected. Extracting base APK...${N}"
    TEMP_EXTRACT=$(mktemp -d)
    unzip -q "$FILE_PATH" "*.apk" -d "$TEMP_EXTRACT" 2>/dev/null
    APK_COUNT=$(find "$TEMP_EXTRACT" -maxdepth 2 -iname "*.apk" | wc -l)
    BASE_APK=$(find "$TEMP_EXTRACT" -maxdepth 2 -iname "*.apk" ! -iname "config.*" | head -n 1)

    if [ "$APK_COUNT" -gt 1 ]; then
      echo -e "${Y}[WARN] Split bundle contains $APK_COUNT APKs. Attempting base APK install...${N}"
    fi

    if [ -n "$BASE_APK" ]; then
      INSTALL_TARGET="$BASE_APK"
    else
      echo -e "${R}[ERR] Could not extract a valid .apk from the .xapk bundle.${N}"
      rm -rf "$TEMP_EXTRACT"
      return
    fi
  fi

  BEFORE_COUNT=$(cmd package list packages 2>/dev/null | wc -l)
  echo -e "${C}[EXEC] Launching Android installer for: $(basename "$INSTALL_TARGET")${N}"

  if ! termux-open "$INSTALL_TARGET"; then
    echo -e "${R}[ERR] Failed to open installer. Enable 'Install unknown apps' for Termux.${N}"
    [ -n "$TEMP_EXTRACT" ] && rm -rf "$TEMP_EXTRACT"
    return
  fi

  read -p "$(echo -e "${Y}Complete the Android popup on screen, then press [Enter] to verify...${N}")"
  AFTER_COUNT=$(cmd package list packages 2>/dev/null | wc -l)

  if [ "$AFTER_COUNT" -gt "$BEFORE_COUNT" ]; then
    echo -e "${G}[OK] SUCCESS: New app verified as installed on your device!${N}"
    MSG="App installed successfully!"
  else
    echo -e "${Y}[NOTICE] Total installed app count did not change.${N}"
    echo -e "${D} -> If you updated an existing app, installation succeeded.${N}"
    echo -e "${D} -> If it failed or was a split .xapk bundle, install via File Manager or SAI.${N}"
    MSG="APK check finished."
  fi

  [ -n "$TEMP_EXTRACT" ] && rm -rf "$TEMP_EXTRACT"
}

download_doc() {
  read -p "$(echo -e "${Y}Custom filename (no extension) or [Enter] for auto: ${N}")" custom_name
  TMP_DIR=$(mktemp -d)
  curl -L -J -O --output-dir "$TMP_DIR" "$1"
  DOWNLOADED_FILE=$(ls -A "$TMP_DIR" | head -n 1)
  if [ -n "$DOWNLOADED_FILE" ]; then
    if [ -n "$custom_name" ]; then
      EXT="${DOWNLOADED_FILE##*.}"
      SAFE_NAME=$(echo "$custom_name" | tr -d '/\:*?"<>|')
      [[ "$SAFE_NAME" == *.* ]] && FINAL_NAME="$SAFE_NAME" || FINAL_NAME="${SAFE_NAME}.${EXT}"
    else
      FINAL_NAME="$DOWNLOADED_FILE"
    fi

    if [[ "${FINAL_NAME,,}" == *.apk || "${FINAL_NAME,,}" == *.xapk ]]; then
      mv "$TMP_DIR/$DOWNLOADED_FILE" "$APK_DIR/$FINAL_NAME"
      echo -e "${G}[OK] Saved package to: Documents/APKs/$FINAL_NAME${N}"
      read -p "$(echo -e "${Y}Install $FINAL_NAME right now? (y/n): ${N}")" inst_now
      if [[ "$inst_now" == "y" || "$inst_now" == "Y" ]]; then
        verify_and_install_apk "$APK_DIR/$FINAL_NAME"
      fi
      SCAN_TARGET="$APK_DIR"
    else
      mv "$TMP_DIR/$DOWNLOADED_FILE" "$DOC_DIR/$FINAL_NAME"
      echo -e "${G}[OK] Saved as: $FINAL_NAME${N}"
      MSG="Saved document: $FINAL_NAME"
      SCAN_TARGET="$DOC_DIR"
    fi
  else
    echo -e "${R}[ERR] Download failed.${N}"
    MSG="Document download failed."
  fi
  rm -rf "$TMP_DIR"
}

online_app_installer() {
  if ! command -v apkeep &> /dev/null; then
    echo -e "${Y}[INFO] Installing apkeep CLI tool first...${N}"
    pkg install apkeep -y
  fi

  echo -e "${C}╔══════════════════════════════════════════╗${N}"
  echo -e "${C}║${G}   ONLINE REPOSITORY INSTALLER (apkeep)   ${C}║${N}"
  echo -e "${C}╠══════════════════════════════════════════╣${N}"
  echo -e "${C}║${W} [01] APKPure Source (Mainstream Apps)    ${C}║${N}"
  echo -e "${C}║${W} [02] F-Droid Source (Open-Source Apps)   ${C}║${N}"
  echo -e "${C}║${R} [00] Cancel                              ${C}║${N}"
  echo -e "${C}╚══════════════════════════════════════════╝${N}"
  read -p "$(echo -e "${Y}Select source [01-02]: ${N}")" src_choice

  if [[ "$src_choice" == "00" || "$src_choice" == "0" || -z "$src_choice" ]]; then
    echo -e "${D}Cancelled.${N}"
    return
  fi

  read -p "$(echo -e "${Y}Target app name or package ID (e.g., vlc, sai, whatsapp): ${N}")" query
  if [ -z "$query" ]; then
    echo -e "${D}Cancelled.${N}"
    return
  fi

  case "${query,,}" in
    x|twitter) PKG_ID="com.twitter.android" ;;
    whatsapp) PKG_ID="com.whatsapp" ;;
    telegram) PKG_ID="org.telegram.messenger" ;;
    tiktok) PKG_ID="com.zhiliaoapp.musically" ;;
    instagram) PKG_ID="com.instagram.android" ;;
    facebook) PKG_ID="com.facebook.katana" ;;
    chrome) PKG_ID="com.android.chrome" ;;
    vlc) PKG_ID="org.videolan.vlc" ;;
    spotify) PKG_ID="com.spotify.music" ;;
    sai) PKG_ID="com.aefyr.sai.fdroid" ;;
    *) PKG_ID="$query" ;;
  esac

  if [[ "$PKG_ID" != *.* ]]; then
    echo -e "${C}[SCAN] Resolving package ID for '$query'...${N}"
    HTML_PAGE=$(curl -s -L -A "Mozilla/5.0" --max-time 15 --get --data-urlencode "q=$query" "https://apkpure.com")
    FOUND_PKG=$(printf "%s" "$HTML_PAGE" | grep -oE '/[a-zA-Z0-9_-]+/[a-zA-Z0-9_]+\.[a-zA-Z0-9_.]+' | head -n 1 | cut -d'/' -f3)
    if [ -n "$FOUND_PKG" ]; then
      PKG_ID="$FOUND_PKG"
      echo -e "${G}[MATCH] Package ID: $PKG_ID${N}"
    else
      echo -e "${R}[ERR] Could not resolve package ID. Enter exact ID (e.g., org.videolan.vlc).${N}"
      return
    fi
  fi

  if [[ "$src_choice" == "02" || "$src_choice" == "2" ]]; then
    SOURCE_FLAG="f-droid"
  else
    SOURCE_FLAG="apk-pure"
  fi

  echo -e "${C}[DOWN] Pulling $PKG_ID from $SOURCE_FLAG...${N}"
  apkeep -a "$PKG_ID" -d "$SOURCE_FLAG" "$APK_DIR"

  LATEST_APK=$(ls -t "$APK_DIR"/"$PKG_ID"* 2>/dev/null | head -n 1)
  if [ -n "$LATEST_APK" ]; then
    verify_and_install_apk "$LATEST_APK"
    SCAN_TARGET="$APK_DIR"
  else
    echo -e "${R}[ERR] Download failed or package blocked by remote server.${N}"
    MSG="Failed to download $PKG_ID."
  fi
}

