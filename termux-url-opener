  case $v_choice in
    01|1) run_ytdlp $BASE_FLAGS -f "bestvideo[ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]/best" -P "$VIDEO_DIR" -o "$OUT_TMPL" "$1"; SCAN_TARGET="$VIDEO_DIR" ;;
    02|2) run_ytdlp $BASE_FLAGS $SUB_FLAGS -f "bestvideo[ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]/best" -P "$VIDEO_DIR" -o "$OUT_TMPL" "$1"; SCAN_TARGET="$VIDEO_DIR" ;;
    03|3) run_ytdlp $BASE_FLAGS $SUB_FLAGS -f "bestvideo[height<=720][ext=mp4]+bestaudio[ext=m4a]/best[height<=720]" -P "$VIDEO_DIR" -o "$OUT_TMPL" "$1"; SCAN_TARGET="$VIDEO_DIR" ;;
    04|4) run_ytdlp $BASE_FLAGS $SUB_FLAGS -f "bestvideo[height<=480][ext=mp4]+bestaudio[ext=m4a]/best[height<=480]" -P "$VIDEO_DIR" -o "$OUT_TMPL" "$1"; SCAN_TARGET="$VIDEO_DIR" ;;
    05|5) run_ytdlp $BASE_FLAGS $SUB_FLAGS -f "bestvideo[height<=360][ext=mp4]+bestaudio[ext=m4a]/best[height<=360]" -P "$VIDEO_DIR" -o "$OUT_TMPL" "$1"; SCAN_TARGET="$VIDEO_DIR" ;;
    06|6) run_ytdlp $BASE_FLAGS -f "bestvideo[ext=mp4]" -P "$VIDEO_DIR" -o "$OUT_TMPL" "$1"; SCAN_TARGET="$VIDEO_DIR" ;;
    07|7)
      read -p "$(echo -e "${Y}Start time (e.g., 00:01:30): ${N}")" start_t
      read -p "$(echo -e "${Y}End time   (e.g., 00:02:15): ${N}")" end_t
      run_ytdlp -4 -N 2 --download-sections "*${start_t}-${end_t}" --force-keyframes-at-cuts -f "bestvideo[ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]/best" -P "$VIDEO_DIR" -o "%(title)s [clip].%(ext)s" "$1"
      SCAN_TARGET="$VIDEO_DIR"
      ;;
    08|8)
      echo -e "${G}[TURBO] Engaging 8 parallel fragment streams (-N 8)...${N}"
      run_ytdlp -4 -N 8 --download-archive "$ARCHIVE_FILE" -f "bestvideo[ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]/best" -P "$VIDEO_DIR" -o "$OUT_TMPL" "$1"
      SCAN_TARGET="$VIDEO_DIR"
      ;;
    00|0|9) echo -e "${D}Cancelled.${N}" ;;
    *) echo -e "${R}[ERR] Invalid video option.${N}" ;;
  esac
}

install_apk_scanner() {
  read -p "$(echo -e "${Y}Enter APK name to search (or press [Enter] to list all): ${N}")" apk_query
  echo -e "${C}[SCAN] Searching entire internal storage for matching packages...${N}"

  CLEAN_Q="${apk_query%.apk}"
  CLEAN_Q="${CLEAN_Q%.xapk}"

  if [ -n "$CLEAN_Q" ]; then
    mapfile -t APK_LIST < <(find -L ~/storage/shared -path "*/Android/data" -prune -o -path "*/Android/obb" -prune -o -type f \( -iname "*${CLEAN_Q}*.apk" -o -iname "*${CLEAN_Q}*.xapk" \) -print 2>/dev/null)
  else
    mapfile -t APK_LIST < <(find -L ~/storage/shared -path "*/Android/data" -prune -o -path "*/Android/obb" -prune -o -type f \( -iname "*.apk" -o -iname "*.xapk" \) -print 2>/dev/null)
  fi

  if [ ${#APK_LIST[@]} -eq 0 ]; then
    echo -e "${R}[ERR] No matching .apk or .xapk files found for '$apk_query'.${N}"
    MSG="No matching APK files found."
    return
  fi

  echo -e "${C}╔══════════════════════════════════════════╗${N}"
  echo -e "${C}║${G}  FOUND ${#APK_LIST[@]} MATCHING PACKAGE(S)             ${C}║${N}"
  echo -e "${C}╠══════════════════════════════════════════╣${N}"
  for i in "${!APK_LIST[@]}"; do
    REL_PATH="${APK_LIST[$i]#$HOME/storage/shared/}"
    printf "${C}║${W} [%02d] %s${N}\n" $((i+1)) "$REL_PATH"
  done
  echo -e "${C}║${R} [00] Cancel                              ${C}║${N}"
  echo -e "${C}╚══════════════════════════════════════════╝${N}"
  read -p "$(echo -e "${Y}Select package number to install: ${N}")" apk_num

  if [[ "$apk_num" == "00" || "$apk_num" == "0" ]]; then
    echo -e "${D}Installation cancelled.${N}"
    return
  fi

  if ! [[ "$apk_num" =~ ^[0-9]+$ ]] || [ "$apk_num" -lt 1 ] || [ "$apk_num" -gt ${#APK_LIST[@]} ]; then
    echo -e "${R}[ERR] Invalid selection number.${N}"
    return
  fi

  verify_and_install_apk "${APK_LIST[$((apk_num-1))]}"
}

android_submenu() {
  echo -e "${C}╔══════════════════════════════════════════╗${N}"
  echo -e "${C}║${G}     ANDROID & NETWORK CONTROL PANEL      ${C}║${N}"
  echo -e "${C}╠══════════════════════════════════════════╣${N}"
  echo -e "${C}║${W} [01] Network Mode (4G Only / Auto)       ${C}║${N}"
  echo -e "${C}║${W} [02] App Info & Cache Manager (Search)   ${C}║${N}"
  echo -e "${C}║${W} [03] Battery Optimization Settings       ${C}║${N}"
  echo -e "${C}║${W} [04] Mobile Data & Data Saver            ${C}║${N}"
  echo -e "${C}║${W} [05] Phone Storage & Space Cleaner       ${C}║${N}"
  echo -e "${C}║${G} [06] Local APK Scanner (Search by Name)  ${C}║${N}"
  echo -e "${C}║${G} [07] Online App Downloader (apkeep)      ${C}║${N}"
  echo -e "${C}║${R} [00] Cancel                              ${C}║${N}"
  echo -e "${C}╚══════════════════════════════════════════╝${N}"
  read -p "$(echo -e "${Y}Execute module [01-07]: ${N}")" a_choice

  case $a_choice in
    01|1)
      echo -e "${Y}[INFO] Pick 'LTE only' for 4G lock; restore 'LTE/WCDMA' or 'Auto' for calls.${N}"
      am start -n com.android.phone/.settings.RadioInfo
      ;;
    02|2)
      read -p "$(echo -e "${Y}Enter app name (e.g., youtube, tiktok, chrome): ${N}")" app_query
      PKG=$(cmd package list packages 2>/dev/null | sed 's/package://g' | grep -i "$app_query" | head -n 1)
      if [ -n "$PKG" ]; then
        echo -e "${G}[OK] Opening App Info: $PKG${N}"
        am start -a android.settings.APPLICATION_DETAILS_SETTINGS -d "package:$PKG"
      else
        echo -e "${Y}[INFO] Opening full Installed Apps list...${N}"
        am start -a android.settings.APPLICATION_SETTINGS
      fi
      ;;
    03|3) am start -a android.settings.IGNORE_BATTERY_OPTIMIZATION_SETTINGS ;;
    04|4) am start -a android.settings.DATA_USAGE_SETTINGS ;;
    05|5) am start -a android.settings.INTERNAL_STORAGE_SETTINGS ;;
    06|6) install_apk_scanner ;;
    07|7) online_app_installer ;;
    00|0|8) echo -e "${D}Cancelled.${N}" ;;
    *) echo -e "${R}[ERR] Invalid tool option.${N}" ;;
  esac
}

CLEAN_URL="${1%%\?*}"

if [[ "$1" == *"t.me/"* ]]; then
  echo -e "${C}[TG] Telegram link detected! Engaging 8-thread download...${N}"
  tdl dl -u "$1" -d "$VIDEO_DIR" -t 8 --continue
  SCAN_TARGET="$VIDEO_DIR"
  MSG="Telegram download finished!"
elif [[ "$CLEAN_URL" =~ \.(pdf|doc|docx|xls|xlsx|ppt|pptx|zip|rar|7z|apk|xapk|epub)$ ]]; then
  echo -e "${C}[FILE] Direct file link detected! Routing automatically...${N}"
  download_doc "$1"
else
  while true; do
    echo -e "${G}╔══════════════════════════════════════════╗${N}"
    echo -e "${G}║${C}    TERMUX CYBER DOWNLOADER & TOOLKIT     ${G}║${N}"
    echo -e "${G}╠══════════════════════════════════════════╣${N}"
    echo -e "${G}║${W} [01] Video / Playlist  -> (Matrix Menu)  ${G}║${N}"
    echo -e "${G}║${W} [02] Audio Only (MP3)  -> Music Folder   ${G}║${N}"
    echo -e "${G}║${W} [03] Thumbnail (JPG)   -> Pictures       ${G}║${N}"
    echo -e "${G}║${W} [04] Document / PDF    -> Documents      ${G}║${N}"
    echo -e "${G}║${W} [05] Batch Links Queue -> nano links.txt ${G}║${N}"
    echo -e "${G}║${C} [06] Android & Network -> 4G, Apps, APKs ${G}║${N}"
    echo -e "${G}║${Y} [07] Update yt-dlp Core                  ${G}║${N}"
    echo -e "${G}║${R} [00] Exit Terminal                       ${G}║${N}"
    echo -e "${G}╚══════════════════════════════════════════╝${N}"
    read -p "$(echo -e "${Y}root@termux:~# ${N}")" choice

    case $choice in
      01|1) video_submenu "$1" ;;
      02|2) run_ytdlp -4 -N 2 --download-archive "$AUDIO_ARCHIVE" -x --audio-format mp3 --embed-thumbnail -P "$MUSIC_DIR" -o "$OUT_TMPL" "$1"; SCAN_TARGET="$MUSIC_DIR" ;;
      03|3) run_ytdlp -4 --write-thumbnail --convert-thumbnails jpg --skip-download -P "$PIC_DIR" -o "%(title)s.%(ext)s" "$1"; SCAN_TARGET="$PIC_DIR" ;;
      04|4) download_doc "$1" ;;
      05|5)
        nano "$BATCH_FILE"
        if [ -s "$BATCH_FILE" ]; then
          echo -e "${C}╔══════════════════════════════════════════╗${N}"
          echo -e "${C}║${G}    BATCH QUEUE RESOLUTION (-N 3 SAFE)    ${C}║${N}"
          echo -e "${C}╠══════════════════════════════════════════╣${N}"
          echo -e "${C}║${W} [01] High Resolution (Best Quality)      ${C}║${N}"
          echo -e "${C}║${W} [02] 720p (740p Cap)                     ${C}║${N}"
          echo -e "${C}║${W} [03] 480p (420p Cap)                     ${C}║${N}"
          echo -e "${C}║${W} [04] 360p (350p Cap)                     ${C}║${N}"
          echo -e "${C}║${R} [00] Exit / Cancel                       ${C}║${N}"
          echo -e "${C}╚══════════════════════════════════════════╝${N}"
          read -p "$(echo -e "${Y}Select batch resolution [01-04]: ${N}")" b_choice
          case $b_choice in
            01|1) run_ytdlp $BATCH_FLAGS -f "bestvideo[ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]/best" -P "$VIDEO_DIR" -o "$OUT_TMPL" -a "$BATCH_FILE" && > "$BATCH_FILE"; SCAN_TARGET="$VIDEO_DIR" ;;
            02|2) run_ytdlp $BATCH_FLAGS -f "bestvideo[height<=740][ext=mp4]+bestaudio[ext=m4a]/best[height<=740]" -P "$VIDEO_DIR" -o "$OUT_TMPL" -a "$BATCH_FILE" && > "$BATCH_FILE"; SCAN_TARGET="$VIDEO_DIR" ;;
            03|3) run_ytdlp $BATCH_FLAGS -f "bestvideo[height<=480][ext=mp4]+bestaudio[ext=m4a]/best[height<=480]" -P "$VIDEO_DIR" -o "$OUT_TMPL" -a "$BATCH_FILE" && > "$BATCH_FILE"; SCAN_TARGET="$VIDEO_DIR" ;;
            04|4) run_ytdlp $BATCH_FLAGS -f "bestvideo[height<=360][ext=mp4]+bestaudio[ext=m4a]/best[height<=360]" -P "$VIDEO_DIR" -o "$OUT_TMPL" -a "$BATCH_FILE" && > "$BATCH_FILE"; SCAN_TARGET="$VIDEO_DIR" ;;
            00|0|5) echo -e "${D}Batch cancelled. Links kept in ~/links.txt.${N}" ;;
            *) echo -e "${R}[ERR] Invalid option.${N}" ;;
          esac
        else
          echo -e "${D}~/links.txt is empty.${N}"
        fi
        ;;
      06|6) android_submenu ;;
      07|7) pip install -U yt-dlp ;;
      00|0|8) echo -e "${D}Session terminated.${N}"; break ;;
      *) echo -e "${R}[ERR] Invalid command.${N}" ;;
    esac

    echo ""
    read -p "$(echo -e "${Y}Continue to Main Menu? (y/n): ${N}")" cont_choice
    if [[ "$cont_choice" != "y" && "$cont_choice" != "Y" ]]; then
      break
    fi
  done
fi

if [ -n "$SCAN_TARGET" ] && command -v termux-media-scan &> /dev/null; then
  termux-media-scan -r "$SCAN_TARGET"
fi

if command -v termux-notification &> /dev/null; then
  termux-notification --title "Termux Cyber Toolkit" --content "${MSG:-Task completed!}" --sound
fi

command -v termux-wake-unlock &> /dev/null && termux-wake-unlock

echo -e "${G}[OK] Done!${N}"
sleep 2
