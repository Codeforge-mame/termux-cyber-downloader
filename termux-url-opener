  echo -e "${C}║${G}     VIDEO / PLAYLIST MATRIX (ANTI-429)   ${C}║${N}"
  echo -e "${C}╠══════════════════════════════════════════╣${N}"
  echo -e "${C}║${W} [01] Best Quality (MP4)                  ${C}║${N}"
  echo -e "${C}║${W} [02] Best Quality + Subtitles            ${C}║${N}"
  echo -e "${C}║${W} [03] 720p + Subtitles                    ${C}║${N}"
  echo -e "${C}║${W} [04] 480p + Subtitles (Data Saver)       ${C}║${N}"
