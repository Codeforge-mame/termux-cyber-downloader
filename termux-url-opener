#!/data/data/com.termux/files/usr/bin/bash
set -o pipefail
SCRIPT_DIR="$(cd -- "$(dirname -- "$0")" && pwd)"
ROOT="$SCRIPT_DIR"
if [ ! -r "$ROOT/lib/colors.sh" ] && [ -r "$HOME/termux-cyber-downloader/lib/colors.sh" ]; then
  ROOT="$HOME/termux-cyber-downloader"
fi
for file in "$ROOT/lib/colors.sh" "$ROOT/lib/config.sh" "$ROOT/lib/common.sh" "$ROOT/modules/video.sh" "$ROOT/modules/documents.sh" "$ROOT/modules/documents/search.sh" "$ROOT/modules/documents/menu.sh" "$ROOT/modules/image.sh" "$ROOT/modules/telegram.sh" "$ROOT/modules/queue.sh" "$ROOT/modules/apk.sh" "$ROOT/modules/movie.sh" "$ROOT/modules/main_menu.sh" "$ROOT/modules/tools.sh"; do
  [ -r "$file" ] || { printf '[ERR] Missing toolkit file: %s\n' "$file" >&2; exit 1; }
  source "$file"
done
command -v termux-wake-lock >/dev/null 2>&1 && termux-wake-lock
cleanup() { command -v termux-wake-unlock >/dev/null 2>&1 && termux-wake-unlock; }
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
if [[ "${1:-}" == "help" || "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then bash "$ROOT/help_script"; exit $?; fi
URL="${1:-}"
if [ -z "$URL" ] && command -v termux-clipboard-get >/dev/null 2>&1; then
  candidate="$(termux-clipboard-get 2>/dev/null)"
  valid_url "$candidate" && URL="$candidate"
fi
CLEAN_URL="${URL%%\?*}"
if [[ "$CLEAN_URL" =~ \.(pdf|doc|docx|xls|xlsx|ppt|pptx|zip|rar|7z|epub|txt|csv|apk|xapk)$ ]]; then
  document_download "$URL"
  rc=$?
  notify_done "File download finished."
  exit "$rc"
fi
if [[ "$URL" == *t.me/* ]]; then
  telegram_download "$URL"
  rc=$?
  notify_done "Telegram task finished."
  exit "$rc"
fi
main_menu "$URL"
